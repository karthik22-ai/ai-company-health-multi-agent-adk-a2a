# --- LLM. Without any of these the backend runs on a deterministic mock LLM. ---
# Option A (recommended): Vertex AI on your own Google Cloud project, authenticated with Application Default Credentials
#   (one-time:  gcloud auth application-default login   – no key is stored in this file)
HQ_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Option B: Gemini API key from Google AI Studio
GOOGLE_API_KEY=
HQ_MODEL_FAST=gemini-3.5-flash
HQ_MODEL_PRO=gemini-3.1-pro-preview   # used only by the agents in HQ_PRO_AGENTS (default: CEO and CFO)
# HQ_MOCK_LLM=true            # force the mock even when a key is present

# --- Server ---
HQ_HOST=127.0.0.1
HQ_PORT=8787
# HQ_AUTH_TOKEN=change-me      # require Authorization: Bearer / ?token= on REST and WebSocket

# --- Behaviour ---
HQ_STEP_DELAY=1.0              # pacing of the mock LLM (seconds per step)
HQ_AUTO_MEETINGS=false         # agents may only gather in meeting rooms when this is true or a workflow/user asks
HQ_A2A_TRANSPORT=asgi          # asgi = in-process (full A2A protocol, no sockets) | http = real HTTP to HQ_PUBLIC_URL
# HQ_PUBLIC_URL=http://127.0.0.1:8787
